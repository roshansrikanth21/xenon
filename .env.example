# Xenon local configuration. Copy to .env and fill in only what you use.
# Xenon is local-first: keys are optional unless you enable a cloud model.

# Model provider for answers and vision fallback (leave empty for local-only).
XENON_MODEL_PROVIDER=
XENON_MODEL_NAME=
XENON_MODEL_API_KEY=

# Screen context
XENON_MAX_CONTROLS=200
XENON_UIA_MAX_DEPTH=4
XENON_MAX_CONTEXT_CHARS=6000

# Memory sources. Paths stay on this machine; nothing is uploaded.
XENON_DB_PATH=memory/xenon.db
XENON_OBSIDIAN_VAULT=
XENON_CLAUDE_EXPORT_DIR=
XENON_CODEX_EXPORT_DIR=
XENON_NOTION_TOKEN=
XENON_NOTION_ROOT_PAGE=

# Voice loop
XENON_WAKE_WORD=xenon
XENON_STT_MODEL=

# Agent Skills (metadata is loaded at startup, instructions on demand)
XENON_SKILLS_DIR=skills
