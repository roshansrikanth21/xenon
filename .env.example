# Xenon local configuration. Copy to .env and fill in only what you use.
# Xenon is local-first: keys are optional unless you enable a cloud model.

# Model provider for answers and vision fallback (leave empty for local-only).
XENON_MODEL_PROVIDER=
XENON_MODEL_NAME=
XENON_MODEL_API_KEY=
XENON_MODEL_BASE_URL=
# Leave empty to use the provider default; use http://127.0.0.1:11434/v1 for Ollama.
XENON_MODEL_TIMEOUT_S=60
# Cap generated tokens so a local 7B model cannot ramble for half a minute.
XENON_MAX_TOKENS=220
# Keep an Ollama model loaded between requests (loopback endpoints only).
# Set to off to let it unload; the next request then pays a ~16 s cold load.
XENON_KEEP_ALIVE=2h

# Screen context
XENON_MAX_CONTROLS=200
XENON_UIA_MAX_DEPTH=4
XENON_MAX_CONTEXT_CHARS=6000

# Local OCR fallback (Windows built-in engine, no network). Set to off to disable.
XENON_OCR=1

# Optional cloud vision. Set at least one XENON_VISION_* value to opt in; the
# text model's key alone never enables it.
XENON_VISION_API_KEY=
XENON_VISION_MODEL=
XENON_VISION_BASE_URL=
XENON_VISION_TIMEOUT_S=20

# Memory sources. Paths stay on this machine; nothing is uploaded.
XENON_DB_PATH=memory/xenon.db
XENON_OBSIDIAN_VAULT=
XENON_CLAUDE_EXPORT_DIR=
XENON_CODEX_EXPORT_DIR=
XENON_NOTION_TOKEN=
XENON_NOTION_ROOT_PAGE=

# Voice loop (fully local: SAPI for speech out, faster-whisper for speech in)
XENON_WAKE_WORD=xenon
# Whisper does not always spell an invented name the way you say it.
XENON_WAKE_ALIASES=zenon,see none
XENON_VAD_THRESHOLD=0.015
XENON_MIC_DEVICE=
XENON_WHISPER_MODEL=base
XENON_WHISPER_DEVICE=cpu
XENON_WHISPER_COMPUTE=int8
XENON_WHISPER_BEAM=3
# Biases the transcript toward your wake word; defaults to "<Wake word>."
XENON_WHISPER_PROMPT=

# Agent Skills (metadata is loaded at startup, instructions on demand)
XENON_SKILLS_DIR=skills
